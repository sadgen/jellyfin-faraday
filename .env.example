# Jellyfin Server URL (Optional default for development)
# Replace with your actual server URL in .env.local
VITE_JELLYFIN_SERVER_URL=https://your-jellyfin-domain.example.com

# Reverse-proxy host allowlist for vite dev/preview servers (comma-separated).
# Vite 5.4+ blocks non-localhost Host headers by default; set your proxy domain in .env.local
VITE_ALLOWED_HOSTS=app.your-domain.example.com

# Enable/Disable External Players (mpv, potplayer, vlc)
VITE_ENABLE_EXTERNAL_PLAYERS=true

# Default Tile Count (1, 2, 4)
VITE_DEFAULT_TILES=2
